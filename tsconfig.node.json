{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "/src/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*.ts",
    "src/**/*.d.ts"
  ]
}
